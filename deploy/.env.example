# Set these three first.
SWARMLOOP_VERSION=
# Absolute path of one host directory. It holds data/ and worktrees/.
SWARMLOOP_HOME=
# Absolute path of the directory with your git checkouts.
CHECKOUTS_ROOT=
# SWARMLOOP_REGISTRY=ghcr.io/swarmloop

# The server needs every variable below without a schema default. Change only what you need.
RUNTIME=cursor # cursor | claude | codex
REQUIREMENTS_VIA=agent
ISSUE_TRACKER=jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=
GITHUB_BASE_URL=https://github.com
GITHUB_TOKEN=
# The key of the runtime you chose:
CURSOR_API_KEY=
ANTHROPIC_API_KEY=
CODEX_API_KEY=
MAX_AGENT_CALLS=100
MAX_RETURNS=10
MAX_LAUNCHES=3
MAX_RUN_USD=100
IDLE_TIMEOUT_MS=900000
TICK_MS=15000
REQUIREMENTS_TIMEOUT_MS=600000
RESEARCH_TIMEOUT_MS=900000
PLAN_TIMEOUT_MS=1200000
IMPLEMENT_TIMEOUT_MS=1800000
CODE_REVIEW_TIMEOUT_MS=900000
MERGE_REQUEST_TIMEOUT_MS=600000
PIPELINE_TIMEOUT_MS=1800000
PIPELINE_START_TIMEOUT_MS=180000
# cursor: grok-4.7-high
# claude: claude-haiku-5-5
# codex: gpt-6.1-sol
MODEL_RESEARCH=grok-4.7-high
MODEL_PLAN=grok-4.7-xhigh
MODEL_IMPLEMENT=grok-4.7-high
