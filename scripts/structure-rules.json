{
  "mustNotExist": ["nest", "next", "docker/nest", "docker/next"],
  "forbidPattern": {
    "pattern": "--prefix (nest|next)\\b|swarmloop-(nest|next)\\b",
    "exclude": ["docs/refactor/"]
  },
  "forbidOutside": [
    {
      "include": "server/src/",
      "allowFiles": ["server/src/core/free-bytes.ts"],
      "pattern": "bsize"
    },
    {
      "include": "dashboard/app/login/",
      "allowFiles": ["dashboard/app/login/hosts.tsx"],
      "exclude": "\\.test\\.tsx?$",
      "pattern": "[Gg]it[Hh]ub|[Gg]it[Ll]ab"
    },
    {
      "include": "server/src/",
      "allowFiles": ["server/src/sandbox/image-resolver"],
      "allowLine": "-placeholder|mkdtemp|EGRESS_CONTAINER",
      "pattern": "swarmloop-(agent-|egress)"
    },
    {
      "include": "server/src/",
      "exclude": "\\.spec\\.ts$",
      "allowFiles": ["server/src/api/run-view/live.ts"],
      "pattern": "kind: 'log'|ARTIFACTS\\.log\\b"
    },
    {
      "include": "server/src/steps/",
      "pattern": "env\\.(RUNTIME|MODEL_\\w+)"
    },
    {
      "include": "server/src/environment/",
      "pattern": "env\\.(RUNTIME|MODEL_\\w+)"
    },
    {
      "include": "server/src/agent/",
      "pattern": "env\\.(RUNTIME|MODEL_\\w+)"
    },
    {
      "include": "server/src/",
      "exclude": "\\.spec(-helpers)?\\.ts$",
      "allowFiles": ["server/src/steps/checks/checks.step.ts", "server/src/environment/"],
      "pattern": "\\benvironments\\.check\\b"
    },
    {
      "include": "server/src/",
      "allowFiles": ["server/src/history/migrations/"],
      "pattern": "brainstorm"
    },
    {
      "include": "dashboard/",
      "pattern": "brainstorm"
    },
    {
      "include": "server/src/",
      "exclude": "\\.spec(-helpers)?\\.ts$|/fixtures?/|package-lock\\.json$|tsconfig[^/]*\\.json$|vitest\\.config\\.ts$|/golden/",
      "pattern": "node_modules|\\.venv|['\"`/](vendor|target)['\"`/]"
    },
    {
      "include": "dashboard/",
      "exclude": "\\.spec(-helpers)?\\.ts$|/fixtures?/|package-lock\\.json$|tsconfig[^/]*\\.json$|vitest\\.config\\.ts$|/golden/",
      "pattern": "node_modules|\\.venv|['\"`/](vendor|target)['\"`/]"
    },
    {
      "include": "skills/",
      "exclude": "\\.spec(-helpers)?\\.ts$|/fixtures?/|package-lock\\.json$|tsconfig[^/]*\\.json$|vitest\\.config\\.ts$|/golden/",
      "pattern": "node_modules|\\.venv|['\"`/](vendor|target)['\"`/]"
    },
    {
      "include": "docker/",
      "exclude": "\\.spec(-helpers)?\\.ts$|/fixtures?/|package-lock\\.json$|tsconfig[^/]*\\.json$|vitest\\.config\\.ts$|/golden/",
      "pattern": "node_modules|\\.venv|['\"`/](vendor|target)['\"`/]"
    },
    {
      "include": ["server/src/steps/", "server/src/pipeline/", "server/src/api/"],
      "exclude": "\\.spec(-helpers)?\\.ts$",
      "allowFiles": [
        "server/src/steps/shared/agent-launcher.ts",
        "server/src/steps/shared/model-visit.ts",
        "server/src/steps/shared/agent-result.ts",
        "server/src/steps/shared/result-exchange.ts",
        "server/src/steps/code-review/review-select.ts",
        "server/src/api/run-view/live.ts",
        "server/src/api/run-queries-log.ts",
        "server/src/api/run-queries.service.ts",
        "server/src/api/run-view/visit-parts.ts",
        "server/src/api/run-view/flow.ts",
        "server/src/api/run-view/chips.ts",
        "server/src/api/run-view/reviewer-steps.ts",
        "server/src/api/chat.service.ts",
        "server/src/pipeline/run-settler.ts"
      ],
      "pattern": "\\.responseText\\b|\\bstepOutput\\("
    },
    {
      "include": ["server/src/steps/", "server/src/pipeline/", "server/src/api/"],
      "exclude": "\\.spec(-helpers)?\\.ts$",
      "allowFiles": [
        "server/src/steps/shared/answers.ts",
        "server/src/steps/merge-request/merge-request-record.ts",
        "server/src/steps/plan/plan-tasks.ts",
        "server/src/steps/shared/handoff.ts"
      ],
      "pattern": "(^|[^.\\w])(section|items)\\(|split\\('\\|'\\)"
    },
    {
      "include": ["server/src/steps/", "server/src/pipeline/", "server/src/api/"],
      "exclude": "\\.spec(-helpers)?\\.ts$",
      "allowFiles": [
        "server/src/steps/shared/answers.ts",
        "server/src/steps/merge-request/merge-request-record.ts",
        "server/src/steps/plan/plan-tasks.ts",
        "server/src/steps/shared/handoff.ts"
      ],
      "pattern": "/\\^[^/]*:[^/]*\\/[gimsuy]*m",
      "allowLine": "^\\s*const (MET|result|job) = "
    },
    {
      "include": ["server/src/steps/", "server/src/pipeline/", "server/src/api/"],
      "exclude": "\\.spec(-helpers)?\\.ts$",
      "allowFiles": [
        "server/src/steps/shared/answers.ts",
        "server/src/steps/merge-request/merge-request-record.ts",
        "server/src/steps/plan/plan-tasks.ts",
        "server/src/steps/shared/handoff.ts"
      ],
      "pattern": "End with these sections|\\bdecision: (ok\\|return|ok or return|return or ok)"
    },
    {
      "include": "dashboard/",
      "exclude": "\\.test\\.tsx?$|^dashboard/test/",
      "allowLine": "=== 'decision: (ok|return)'|replace\\('decision: '|startsWith\\('decision:'",
      "pattern": "['\"`/]\\s*\\^?decision:"
    }
  ],
  "forbidInFile": [
    {
      "file": "skills/code-review/requirements/SKILL.md",
      "pattern": "A behavior that checklist removes is not a missing requirement"
    },
    {
      "file": "compose.yml",
      "pattern": "^\\s*build:"
    },
    {
      "file": "compose.yml",
      "pattern": "^\\s*context:"
    },
    {
      "file": "compose.yml",
      "pattern": "^\\s*dockerfile:"
    },
    {
      "file": "compose.yml",
      "pattern": "pull_policy:\\s*build"
    },
    {
      "file": "compose.yml",
      "pattern": "^\\s*sloop:"
    },
    {
      "file": "compose.yml",
      "pattern": "(^|[\\s'\\\"])\\.{1,2}/"
    },
    {
      "file": ".github/workflows/release.yml",
      "pattern": "^\\s*branches\\s*:"
    },
    {
      "file": ".github/workflows/release.yml",
      "pattern": "^\\s*pull_request\\s*:"
    },
    {
      "file": ".github/workflows/release.yml",
      "pattern": "^\\s*schedule\\s*:"
    },
    {
      "file": "compose.yml",
      "pattern": "data[^\\n]*:/app/dashboard"
    },
    {
      "file": "compose.build.yml",
      "pattern": "data[^\\n]*:/app/dashboard"
    }
  ]
}
