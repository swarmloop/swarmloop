{
  "mustNotExist": ["nest", "next", "docker/nest", "docker/next"],
  "forbidPattern": {
    "pattern": "--prefix (nest|next)\\b|swarmloop-(nest|next)\\b",
    "exclude": ["docs/refactor/"]
  },
  "forbidOutside": [
    {
      "include": "server/src/",
      "allowFiles": ["server/src/history/run-state.ts", "server/src/history/run-state.spec.ts"],
      "pattern": "\\bderiveState\\b"
    },
    {
      "include": [
        "server/src/history/run-state.ts",
        "server/src/api/run-view/flow-waiting.ts",
        "server/src/pipeline/command.service.ts",
        "server/src/steps/shared/run-state-refresh.ts"
      ],
      "allowLine": "latest\\(current, 'error'\\)|A required check failed again on unchanged files\\.",
      "pattern": "\\bblockCode\\b|\\bdidNotFit\\(|\\bisStopNote\\b|does not fit|failed again on unchanged|\\.latestBody\\(|'error'|ARTIFACTS\\.error"
    },
    {
      "include": "server/src/",
      "exclude": "\\.spec(-helpers)?\\.ts$",
      "allowFiles": [
        "server/src/steps/shared/agent-door.ts",
        "server/src/pipeline/backlog/planner/turn-runner.ts",
        "server/src/steps/shared/agent-launcher.ts",
        "server/src/pipeline/pipeline.module.ts",
        "server/src/pipeline/run-settler.ts"
      ],
      "pattern": "\\bAgentLauncher\\b"
    },
    {
      "include": "server/src/",
      "exclude": "\\.spec(-helpers)?\\.ts$",
      "allowFiles": [
        "server/src/pipeline/start-gate.ts",
        "server/src/api/",
        "server/src/cli/",
        "server/src/pipeline/pipeline.service.ts",
        "server/src/pipeline/run-lifecycle.ts",
        "server/src/pipeline/planner-own-turn.ts"
      ],
      "reasons": {
        "server/src/pipeline/planner-own-turn.ts": "sends through CommandService and StartGate as a person's start (PERSON_RESUME)"
      },
      "pattern": "\\b(accept|submit)\\(\\s*'resume'|\\bstartDetached\\(|\\bcommands\\.(accept|submit)\\(\\s*[A-Za-z_$][\\w$.]*\\s*,"
    },
    {
      "include": "server/src/",
      "exclude": "\\.spec(-helpers)?\\.ts$",
      "allowFiles": ["server/src/pipeline/subtask-rebases.ts"],
      "pattern": "byParent:\\s*true"
    },
    {
      "include": "server/src/",
      "exclude": "\\.spec(-helpers)?\\.ts$",
      "allowFiles": [
        "server/src/steps/shared/epic-between-passes.ts",
        "server/src/steps/run-rebase.ts",
        "server/src/pipeline/backlog/epic-main-moves.ts"
      ],
      "pattern": "\\btakesMain\\b"
    },
    {
      "include": "server/src/",
      "exclude": "\\.spec(-helpers)?\\.ts$",
      "allowFiles": [
        "server/src/git/rebase/own-change.ts",
        "server/src/pipeline/parent-tree-sync.ts",
        "server/src/pipeline/subtask-worktrees.ts"
      ],
      "pattern": "'merge-base',\\s*'HEAD'|'--onto'"
    },
    {
      "include": "server/src/",
      "exclude": "\\.spec(-helpers)?\\.ts$",
      "allowFiles": ["server/src/steps/shared/start-waits.ts"],
      "pattern": "\\.recordStartWait\\("
    },
    {
      "include": "server/src/",
      "exclude": "\\.spec(-helpers)?\\.ts$",
      "allowFiles": ["server/src/history/"],
      "pattern": "\\bsaveRun\\b|(InjectRepository|getRepositoryToken|getRepository)\\(RunEntity\\)|\\.(update|insert|into)\\(RunEntity\\)"
    },
    {
      "include": "dashboard/",
      "exclude": "\\.test\\.tsx?$|^dashboard/test/",
      "allowFiles": ["dashboard/features/run/run-state-word.tsx"],
      "pattern": "Record<(RunState|SubtaskStatus|StateIcon|TaskEntry\\['status'\\]),\\s*(typeof\\s|[^>]*\\b(Icon|SvgIconProps|ComponentType|ElementType)\\b)"
    },
    {
      "include": "server/src/",
      "allowFiles": ["server/src/core/free-bytes.ts"],
      "pattern": "bsize"
    },
    {
      "include": "dashboard/app/login/",
      "allowFiles": ["dashboard/app/login/hosts.tsx"],
      "exclude": "\\.test\\.tsx?$",
      "pattern": "[Gg]it[Hh]ub|[Gg]it[Ll]ab"
    },
    {
      "include": "server/src/",
      "allowFiles": ["server/src/sandbox/image-resolver"],
      "allowLine": "-placeholder|mkdtemp|EGRESS_CONTAINER",
      "pattern": "swarmloop-(agent-|egress)"
    },
    {
      "include": "server/src/",
      "exclude": "\\.spec\\.ts$",
      "allowFiles": ["server/src/api/run-view/live.ts"],
      "pattern": "kind: 'log'|ARTIFACTS\\.log\\b"
    },
    {
      "include": "server/src/git/",
      "exclude": "\\.spec(-helpers)?\\.ts$",
      "pattern": "[Gg]it[Hh]ub|[Gg]it[Ll]ab"
    },
    {
      "include": "server/src/integrations/",
      "exclude": "\\.spec(-helpers)?\\.ts$",
      "allowFiles": ["server/src/integrations/code-host/"],
      "pattern": "[Gg]it[Hh]ub|[Gg]it[Ll]ab"
    },
    {
      "include": "server/src/",
      "exclude": "^server/src/integrations/code-host/[^/]+/|^server/src/config/env\\.schema\\.ts$|^server/src/history/migrations/|^server/src/testing/|\\.spec(-helpers)?\\.ts$",
      "pattern": "[Gg][Ii][Tt][Hh][Uu][Bb]|[Gg][Ii][Tt][Ll][Aa][Bb]|[Bb][Ii][Tt][Bb][Uu][Cc][Kk][Ee][Tt]"
    },
    {
      "include": "server/src/",
      "exclude": "^server/src/git/naming/|^server/src/testing/|\\.spec(-helpers)?\\.ts$",
      "pattern": "feature/|feat\\(|renderTemplate\\("
    },
    {
      "include": "server/src/steps/",
      "pattern": "env\\.(RUNTIME|MODEL_\\w+)"
    },
    {
      "include": "server/src/environment/",
      "pattern": "env\\.(RUNTIME|MODEL_\\w+)"
    },
    {
      "include": "server/src/agent/",
      "pattern": "env\\.(RUNTIME|MODEL_\\w+)"
    },
    {
      "include": "server/src/",
      "exclude": "\\.spec(-helpers)?\\.ts$",
      "allowFiles": ["server/src/steps/checks/checks.step.ts", "server/src/environment/"],
      "pattern": "\\benvironments\\.check\\b"
    },
    {
      "include": "server/src/",
      "allowFiles": ["server/src/history/migrations/"],
      "pattern": "brainstorm"
    },
    {
      "include": "dashboard/",
      "pattern": "brainstorm"
    },
    {
      "include": "server/src/",
      "exclude": "\\.spec(-helpers)?\\.ts$|/fixtures?/|package-lock\\.json$|tsconfig[^/]*\\.json$|vitest\\.config\\.ts$|/golden/",
      "pattern": "node_modules|\\.venv|['\"`/](vendor|target)['\"`/]"
    },
    {
      "include": "dashboard/",
      "exclude": "\\.spec(-helpers)?\\.ts$|/fixtures?/|package-lock\\.json$|tsconfig[^/]*\\.json$|vitest\\.config\\.ts$|/golden/",
      "pattern": "node_modules|\\.venv|['\"`/](vendor|target)['\"`/]"
    },
    {
      "include": "skills/",
      "exclude": "\\.spec(-helpers)?\\.ts$|/fixtures?/|package-lock\\.json$|tsconfig[^/]*\\.json$|vitest\\.config\\.ts$|/golden/",
      "pattern": "node_modules|\\.venv|['\"`/](vendor|target)['\"`/]"
    },
    {
      "include": "docker/",
      "exclude": "\\.spec(-helpers)?\\.ts$|/fixtures?/|package-lock\\.json$|tsconfig[^/]*\\.json$|vitest\\.config\\.ts$|/golden/",
      "pattern": "node_modules|\\.venv|['\"`/](vendor|target)['\"`/]"
    },
    {
      "include": ["server/src/steps/", "server/src/pipeline/", "server/src/api/"],
      "exclude": "\\.spec(-helpers)?\\.ts$",
      "allowFiles": [
        "server/src/steps/shared/agent-launcher.ts",
        "server/src/steps/shared/model-visit.ts",
        "server/src/steps/shared/call-end.ts",
        "server/src/steps/shared/agent-result.ts",
        "server/src/steps/shared/result-exchange.ts",
        "server/src/steps/code-review/review-select.ts",
        "server/src/api/run-view/live.ts",
        "server/src/api/run-queries-log.ts",
        "server/src/api/run-queries-history.ts",
        "server/src/api/run-view/visit-parts.ts",
        "server/src/api/run-view/flow.ts",
        "server/src/api/run-view/chips.ts",
        "server/src/api/run-view/reviewer-steps.ts",
        "server/src/pipeline/run-settler.ts",
        "server/src/steps/shared/agent-door.ts"
      ],
      "pattern": "\\.responseText\\b|\\bstepOutput\\("
    },
    {
      "include": ["server/src/steps/", "server/src/pipeline/", "server/src/api/"],
      "exclude": "\\.spec(-helpers)?\\.ts$",
      "allowFiles": [
        "server/src/steps/shared/answers.ts",
        "server/src/steps/merge-request/merge-request-record.ts",
        "server/src/steps/plan/plan-tasks.ts",
        "server/src/steps/shared/handoff.ts"
      ],
      "pattern": "(^|[^.\\w])(section|items)\\(|split\\('\\|'\\)"
    },
    {
      "include": ["server/src/steps/", "server/src/pipeline/", "server/src/api/"],
      "exclude": "\\.spec(-helpers)?\\.ts$",
      "allowFiles": [
        "server/src/steps/shared/answers.ts",
        "server/src/steps/merge-request/merge-request-record.ts",
        "server/src/steps/plan/plan-tasks.ts",
        "server/src/steps/shared/handoff.ts",
        "server/src/steps/contract/artifact-summaries.ts"
      ],
      "pattern": "/\\^[^/]*:[^/]*\\/[gimsuy]*m"
    },
    {
      "include": ["server/src/steps/", "server/src/pipeline/", "server/src/api/"],
      "exclude": "\\.spec(-helpers)?\\.ts$",
      "allowFiles": [
        "server/src/steps/shared/answers.ts",
        "server/src/steps/merge-request/merge-request-record.ts",
        "server/src/steps/plan/plan-tasks.ts",
        "server/src/steps/shared/handoff.ts"
      ],
      "pattern": "End with these sections|\\bdecision: (ok\\|return|ok or return|return or ok)"
    },
    {
      "include": "dashboard/",
      "exclude": "\\.test\\.tsx?$|^dashboard/test/",
      "allowLine": "=== 'decision: (ok|return)'|replace\\('decision: '|startsWith\\('decision:'",
      "pattern": "['\"`/]\\s*\\^?decision:"
    }
  ],
  "forbidInFile": [
    {
      "file": "skills/code-review/requirements/SKILL.md",
      "pattern": "A behavior that checklist removes is not a missing requirement"
    },
    {
      "file": "compose.yml",
      "pattern": "^\\s*build:"
    },
    {
      "file": "compose.yml",
      "pattern": "^\\s*context:"
    },
    {
      "file": "compose.yml",
      "pattern": "^\\s*dockerfile:"
    },
    {
      "file": "compose.yml",
      "pattern": "pull_policy:\\s*build"
    },
    {
      "file": "compose.yml",
      "pattern": "(^|[\\s'\\\"])\\.{1,2}/"
    },
    {
      "file": ".github/workflows/release.yml",
      "pattern": "^\\s*branches\\s*:"
    },
    {
      "file": ".github/workflows/release.yml",
      "pattern": "^\\s*pull_request\\s*:"
    },
    {
      "file": ".github/workflows/release.yml",
      "pattern": "^\\s*schedule\\s*:"
    },
    {
      "file": "compose.yml",
      "pattern": "data[^\\n]*:/app/dashboard"
    },
    {
      "file": "compose.override.yml",
      "pattern": "data[^\\n]*:/app/dashboard"
    }
  ]
}
