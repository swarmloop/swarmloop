{
  "mustNotExist": ["nest", "next", "docker/nest", "docker/next"],
  "forbidPattern": {
    "pattern": "--prefix (nest|next)\\b|swarmloop-(nest|next)\\b",
    "exclude": ["docs/refactor/"]
  },
  "forbidOutside": [
    {
      "include": "server/src/",
      "allowFiles": ["server/src/sandbox/image-resolver"],
      "allowLine": "-placeholder|mkdtemp|EGRESS_CONTAINER",
      "pattern": "swarmloop-(agent-|egress)"
    }
  ],
  "forbidInFile": [
    {
      "file": "skills/code-review/requirements/SKILL.md",
      "pattern": "A behavior that checklist removes is not a missing requirement"
    },
    {
      "file": "compose.yml",
      "pattern": "^\\s*build:"
    },
    {
      "file": "compose.yml",
      "pattern": "^\\s*context:"
    },
    {
      "file": "compose.yml",
      "pattern": "^\\s*dockerfile:"
    },
    {
      "file": "compose.yml",
      "pattern": "pull_policy:\\s*build"
    },
    {
      "file": "compose.yml",
      "pattern": "^\\s*sloop:"
    },
    {
      "file": "compose.yml",
      "pattern": "(^|[\\s'\\\"])\\.{1,2}/"
    },
    {
      "file": ".github/workflows/release.yml",
      "pattern": "^\\s*branches\\s*:"
    },
    {
      "file": ".github/workflows/release.yml",
      "pattern": "^\\s*pull_request\\s*:"
    },
    {
      "file": ".github/workflows/release.yml",
      "pattern": "^\\s*schedule\\s*:"
    }
  ]
}
