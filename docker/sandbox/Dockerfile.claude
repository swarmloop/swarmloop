FROM debian:bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates curl git \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --create-home --uid 1000 --shell /usr/sbin/nologin sandbox \
  && mkdir -p /work \
  && chown sandbox:sandbox /work

USER sandbox
ENV HOME=/home/sandbox
RUN curl -fsSL https://claude.ai/install.sh | bash
USER root
# /home/sandbox is a tmpfs at run time, so the install has to live outside it. No system language runtime.
# Everything the CLI needs lives under /opt/swarmloop, so swarmloop can mount it into a project image.
RUN set -eu \
  && src="$(readlink -f /home/sandbox/.local/bin/claude 2>/dev/null || echo /home/sandbox/.local/bin/claude)" \
  && dir="$(dirname "$src")" \
  && mkdir -p /opt/swarmloop/claude /opt/swarmloop/bin \
  && cp -a "$dir"/. /opt/swarmloop/claude/ \
  && ln -sfn "/opt/swarmloop/claude/$(basename "$src")" /opt/swarmloop/bin/claude \
  && mkdir -p /opt/swarmloop/certs \
  && cp /etc/ssl/certs/ca-certificates.crt /opt/swarmloop/certs/ca-certificates.crt \
  && chmod -R a+rX /opt/swarmloop \
  && ln -sfn /opt/swarmloop/bin/claude /usr/local/bin/claude
USER sandbox
WORKDIR /work
