#!/bin/sh

root=/home/sandbox/.swarmloop
enabled="$root/verify.enabled"
dir="$root/verify"

if [ ! -f "$enabled" ]; then
  echo 'verify is not configured for this project'
  exit 0
fi

mkdir -p "$dir"
id=$(LC_ALL=C tr -dc 'a-z0-9' </dev/urandom | dd bs=12 count=1 2>/dev/null)
repo=${1:-all}
tmp="$dir/$id.tmp"
request="$dir/$id.req"
response="$dir/$id.res"
printf '%s\n' "$repo" > "$tmp"
mv "$tmp" "$request"

limit=${SWARMLOOP_VERIFY_WAIT_S:-1800}
case "$limit" in
  *[!0-9]*|'') limit=1800 ;;
esac
elapsed=0
ticks=$((limit * 2))
while [ "$elapsed" -lt "$ticks" ]; do
  if [ -f "$response" ]; then
    code=$(sed -n '1s/^exit: //p' "$response")
    cat "$response"
    case "$code" in
      0|1|2) exit "$code" ;;
      *) exit 2 ;;
    esac
  fi
  sleep 0.5
  elapsed=$((elapsed + 1))
done

echo 'swarmloop-verify: no answer'
exit 3
