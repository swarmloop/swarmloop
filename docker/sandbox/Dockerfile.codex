FROM debian:bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates curl git ripgrep \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --create-home --uid 1000 --shell /usr/sbin/nologin sandbox \
  && mkdir -p /work \
  && chown sandbox:sandbox /work

COPY swarmloop-verify /usr/local/bin/swarmloop-verify
RUN chmod 755 /usr/local/bin/swarmloop-verify

# /home/sandbox is a tmpfs at run time, so the binary lives outside it.
RUN set -eu \
  && arch="$(uname -m)" \
  && case "$arch" in \
    x86_64) triple=x86_64-unknown-linux-musl ;; \
    aarch64|arm64) triple=aarch64-unknown-linux-musl ;; \
    *) echo "unsupported CPU: $arch" >&2; exit 1 ;; \
  esac \
  && mkdir -p /tmp/codex /opt/codex \
  && curl -fsSL "https://github.com/openai/codex/releases/latest/download/codex-${triple}.tar.gz" -o /tmp/codex/codex.tar.gz \
  && curl -fsSL "https://github.com/openai/codex/releases/latest/download/codex-code-mode-host-${triple}.tar.gz" -o /tmp/codex/host.tar.gz \
  && tar -xzf /tmp/codex/codex.tar.gz -C /tmp/codex \
  && tar -xzf /tmp/codex/host.tar.gz -C /tmp/codex \
  && mv "/tmp/codex/codex-${triple}" /opt/codex/codex-bin \
  && mv "/tmp/codex/codex-code-mode-host-${triple}" /opt/codex/codex-code-mode-host \
  && chmod 755 /opt/codex/codex-bin /opt/codex/codex-code-mode-host \
  && rm -rf /tmp/codex

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 \
  && rm -rf /var/lib/apt/lists/*

COPY codex-auth-proxy.py /usr/local/bin/codex-auth-proxy
RUN chmod 755 /usr/local/bin/codex-auth-proxy

RUN cat > /usr/local/bin/codex <<'EOF'
#!/bin/sh
set -eu
export CODEX_HOME=/home/sandbox/.codex
mkdir -p "$CODEX_HOME"
if [ -d /codex-auth ]; then
  if [ ! -f /codex-auth/auth.json ] && [ -n "${CODEX_AUTH:-}" ]; then
    printf %s "$CODEX_AUTH" | base64 -d > /codex-auth/auth.json
    chmod 600 /codex-auth/auth.json
  fi
  if [ -f /codex-auth/auth.json ]; then
    cp /codex-auth/auth.json "$CODEX_HOME/auth.json"
    chmod 600 "$CODEX_HOME/auth.json"
    unset CODEX_AUTH
    rm -f /tmp/codex-auth-proxy.ready
    /usr/local/bin/codex-auth-proxy /codex-auth/auth.json &
    i=0
    while [ ! -f /tmp/codex-auth-proxy.ready ]; do
      i=$((i + 1))
      if [ "$i" -gt 50 ]; then
        echo "codex auth proxy failed" >&2
        exit 1
      fi
      sleep 0.05
    done
    export CODEX_REFRESH_TOKEN_URL_OVERRIDE=http://127.0.0.1:8765/oauth/token
    exec /opt/codex/codex-bin "$@"
  fi
fi
if [ -n "${CODEX_AUTH:-}" ]; then
  printf %s "$CODEX_AUTH" | base64 -d > "$CODEX_HOME/auth.json"
  chmod 600 "$CODEX_HOME/auth.json"
  unset CODEX_AUTH
else
  rm -f "$CODEX_HOME/auth.json"
fi
exec /opt/codex/codex-bin "$@"
EOF
RUN chmod 755 /usr/local/bin/codex

USER sandbox
WORKDIR /work
