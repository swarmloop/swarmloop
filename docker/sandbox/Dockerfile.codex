FROM debian:bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates curl git ripgrep \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --create-home --uid 1000 --shell /usr/sbin/nologin sandbox \
  && mkdir -p /work \
  && chown sandbox:sandbox /work

# /home/sandbox is a tmpfs at run time, so the binary lives outside it.
ARG CODEX_VERSION=0.167.0
RUN set -eu \
  && arch="$(uname -m)" \
  && case "$arch" in \
    x86_64) triple=x86_64-unknown-linux-musl ;; \
    aarch64|arm64) triple=aarch64-unknown-linux-musl ;; \
    *) echo "unsupported CPU: $arch" >&2; exit 1 ;; \
  esac \
  && mkdir -p /tmp/codex /opt/swarmloop/codex /opt/swarmloop/bin \
  && curl -fsSL "https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/codex-${triple}.tar.gz" -o /tmp/codex/codex.tar.gz \
  && curl -fsSL "https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/codex-code-mode-host-${triple}.tar.gz" -o /tmp/codex/host.tar.gz \
  && tar -xzf /tmp/codex/codex.tar.gz -C /tmp/codex \
  && tar -xzf /tmp/codex/host.tar.gz -C /tmp/codex \
  && mv "/tmp/codex/codex-${triple}" /opt/swarmloop/codex/codex-bin \
  && mv "/tmp/codex/codex-code-mode-host-${triple}" /opt/swarmloop/codex/codex-code-mode-host \
  && chmod 755 /opt/swarmloop/codex/codex-bin /opt/swarmloop/codex/codex-code-mode-host \
  && rm -rf /tmp/codex

# Everything the CLI needs lives under /opt/swarmloop, so swarmloop can mount it into a project image.
# The wrapper needs only sh, mkdir, chmod, rm and base64.
RUN cat > /opt/swarmloop/bin/codex <<'EOF'
#!/bin/sh
set -eu
export CODEX_HOME=/home/sandbox/.codex
mkdir -p "$CODEX_HOME"
if [ -n "${CODEX_AUTH:-}" ]; then
  printf %s "$CODEX_AUTH" | base64 -d > "$CODEX_HOME/auth.json"
  chmod 600 "$CODEX_HOME/auth.json"
  unset CODEX_AUTH
else
  rm -f "$CODEX_HOME/auth.json"
fi
exec /opt/swarmloop/codex/codex-bin "$@"
EOF
# A project image may lack CA certificates and ripgrep, so the bundle carries its own.
RUN mkdir -p /opt/swarmloop/certs \
  && cp /etc/ssl/certs/ca-certificates.crt /opt/swarmloop/certs/ca-certificates.crt \
  && cp /usr/bin/rg /opt/swarmloop/bin/rg \
  && chmod -R a+rX /opt/swarmloop \
  && chmod 755 /opt/swarmloop/bin/codex \
  && ln -sfn /opt/swarmloop/bin/codex /usr/local/bin/codex

# The build fails when the installed CLI is not the pinned version.
RUN /opt/swarmloop/codex/codex-bin --version | grep -qF "$CODEX_VERSION"
ARG SOURCE_URL=unknown
ARG REVISION=unknown
ARG VERSION=dev
LABEL org.opencontainers.image.source=$SOURCE_URL \
      org.opencontainers.image.revision=$REVISION \
      org.opencontainers.image.version=$VERSION \
      io.swarmloop.cli-version=$CODEX_VERSION
USER sandbox
WORKDIR /work
