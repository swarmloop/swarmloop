FROM debian:bookworm-slim

# No language runtime and no VPN. The repository brings what it runs.
RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates curl git \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --create-home --uid 1000 --shell /usr/sbin/nologin sandbox \
  && mkdir -p /work \
  && chown sandbox:sandbox /work

USER sandbox
ENV HOME=/home/sandbox
RUN curl -fsSL https://cursor.com/install | bash
USER root
# The launcher looks for node beside itself. /home/sandbox is a tmpfs at run time, so the install has to live outside it.
# Everything the CLI needs lives under /opt/swarmloop, so swarmloop can mount it into a project image.
RUN set -eu \
  && src="$(readlink -f /home/sandbox/.local/bin/agent)" \
  && dir="$(dirname "$src")" \
  && mkdir -p /opt/swarmloop/cursor-agent /opt/swarmloop/bin \
  && cp -a "$dir"/. /opt/swarmloop/cursor-agent/ \
  && ln -sfn /opt/swarmloop/cursor-agent/cursor-agent /opt/swarmloop/bin/agent \
  && mkdir -p /opt/swarmloop/certs \
  && cp /etc/ssl/certs/ca-certificates.crt /opt/swarmloop/certs/ca-certificates.crt \
  && chmod -R a+rX /opt/swarmloop \
  && ln -sfn /opt/swarmloop/bin/agent /usr/local/bin/agent
USER sandbox
WORKDIR /work
