# Copy to .env next to compose.yml. Set the key of the runtime your AGENTS_* lists name and the token of your code host; the rest can stay.
# A release to pin, such as 0.2.0. Empty: latest.
SWARMLOOP_VERSION=
# Where data/ and worktrees/ live. Empty: next to compose.yml.
SWARMLOOP_HOME=
# From source: build the images from this checkout instead of pulling them.
# COMPOSE_FILE=compose.yml:compose.build.yml

REQUIREMENTS_VIA=agent
ISSUE_TRACKER=jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECTS=
# GITHUB_TOKEN and GITLAB_TOKEN are the fallback for a headless setup, and for runs started by the CLI or a script.
# A run started in the dashboard uses the token of the person who started it (Connect GitHub / Connect GitLab).
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=
GITHUB_BASE_URL=https://github.com
GITHUB_TOKEN=
CURSOR_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
CODEX_AUTH=
CODEX_API_KEY=
MAX_AGENT_CALLS=100
MAX_RETURNS=10
MAX_PIPELINE_RETURNS=6
MAX_LAUNCHES=3
# How long a runtime stays out of use after a provider limit whose text names no reset time.
LIMIT_COOLDOWN_MIN=60
STOP_GRACE_S=10
RECONCILE_MS=60000
# Minutes between looks at done runs for a merged or closed merge request.
MERGE_WATCH_MIN=5
RECOVER_WAIT_MS=600000
# Done runs lose worktrees, agent state and outputs after this many days (0 keeps everything).
RETAIN_DONE_DAYS=3
# A step does not start with less free disk than this; old runs are cleaned first.
MIN_FREE_GB=10
# Once a day remove dangling Docker images and build cache older than 24 h.
DOCKER_PRUNE=true
MAX_RUN_USD=100
MAX_RUN_TOKENS=
STEP_USD_MAX=
STEP_TOKEN_MAX=
IDLE_TIMEOUT_MS=900000
# The same failing command this many times in a row gets one hint; that many more end the step.
LOOP_REPEAT=4
# Every sandbox reaches the internet only through the egress proxy, and only the hosts of its step.
# `open` turns the proxy off and gives the sandboxes the plain Docker network, for debugging only.
SANDBOX_EGRESS=proxy
# Docker runtime of the sandboxes. `runsc` (gVisor, installed on the Docker host) gives each its own kernel,
# so a kernel bug does not reach the host. Empty: Docker's default runtime.
SANDBOX_DOCKER_RUNTIME=
# Hosts a project's .swarmloop.json `hosts` may name, comma-separated. Empty: any host under the built-in ceiling.
PROJECT_HOSTS_ALLOW=
TICK_MS=15000
REQUIREMENTS_TIMEOUT_MS=600000
RESEARCH_TIMEOUT_MS=900000
PLAN_TIMEOUT_MS=1200000
IMPLEMENT_TIMEOUT_MS=1800000
CODE_REVIEW_TIMEOUT_MS=900000
MERGE_REQUEST_TIMEOUT_MS=600000
PIPELINE_TIMEOUT_MS=1800000
PIPELINE_START_TIMEOUT_MS=180000

# Agents: who plans, who writes the code, who reviews. An ordered list of runtime:model[:effort], comma-separated; the next
# one takes over when a usage limit is hit. Every runtime named here needs its key above. Each person can also set
# their own lists in Settings.
#   plan: research, plan, plan improve, merge request text · implement: implement, fixes, rebase conflicts, chat
#   review: every code reviewer and the review report
# Model names: cursor grok-4.7-high · claude claude-opus-5-5, claude-sonnet-5-5 · codex gpt-6.1-sol
# Effort is low, medium, high, xhigh or max; without it the agent runs at its runtime's default.
# Plans and researches at high effort.
AGENTS_PLAN=claude:claude-opus-5-5:high
# Writes the code at high effort.
AGENTS_IMPLEMENT=claude:claude-sonnet-5-5:high
# Reviews at high effort.
AGENTS_REVIEW=claude:claude-opus-5-5:high
# The subtasks of a split run: the parent splits the task and reviews the merged result, so the subtasks can be cheaper.
# Subtask planning at high effort.
AGENTS_SUBTASK_PLAN=claude:claude-sonnet-5-5:high
# Subtask coding at high effort.
AGENTS_SUBTASK_IMPLEMENT=claude:claude-sonnet-5-5:high
# Subtask review at high effort.
AGENTS_SUBTASK_REVIEW=claude:claude-sonnet-5-5:high
# The parent of a split run works at least at this effort once its plan splits; empty turns it off.
EPIC_EFFORT=xhigh

# `auto`: the planner may split a big task into subtasks, `off`: it never does; set per server, not per run in the dashboard.
SPLIT=auto
# Safety limit against a runaway plan on the tasks of one split plan, not a target.
SPLIT_MAX_TASKS=48
# How many subtasks of a split run work at the same time.
SUBTASKS_PARALLEL=3

# The folder swarmloop mounts as its checkouts. Point it at a folder that holds only the repositories swarmloop works on:
# every git clone in it is visible to the server and its agents.
CHECKOUTS_ROOT=../
# Narrow it further: repository folder names under CHECKOUTS_ROOT, comma-separated. Empty means every repository there.
SWARMLOOP_REPOS=
# The address you open the dashboard at. The API and the dashboard answer only to 127.0.0.1, localhost, this host and the compose names.
SWARMLOOP_PUBLIC_URL=http://127.0.0.1:3921
SWARMLOOP_API_PORT=3920
SWARMLOOP_API_HOST=127.0.0.1

# Login to the dashboard: open it and use Connect GitHub (a private GitHub App made from a manifest, on the account that owns the repositories, then installed on them) or Connect GitLab. The variables below
# are optional: an OAuth app configured here keeps working. Every browser request needs a session; the CLI and scripts use SWARMLOOP_TOKEN.
# A server with no login yet answers only on loopback. A private app can be installed only on its owner, and only that account
# or the members of the owning organization can sign in to it; outside collaborators are added to the organization instead.
# The callback of both is SWARMLOOP_PUBLIC_URL plus /auth/github/callback or /auth/gitlab/callback.
# GitHub: an OAuth App. GITHUB_BASE_URL says which GitHub.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# GitLab: an application with scopes read_user and read_api on GITLAB_BASE_URL (self-hosted works).
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
# Who may log in, comma-separated: github:<user>, github-org:<org>, gitlab:<user>, gitlab-group:<group>.
# Empty: a person whose own token can push to at least one repository this server works on (CHECKOUTS_ROOT, narrowed by
# SWARMLOOP_REPOS), on the host they log in with. A plain GitHub OAuth App from this file keeps the owner of GITHUB_TOKEN.
SWARMLOOP_ALLOW=
# The token for the CLI, ACP and scripts, sent as `Authorization: Bearer <token>`. Empty: the server makes one in data/token.
# `docker compose exec server node dist/main.js doctor` prints it.
SWARMLOOP_TOKEN=
# The key that encrypts the stored GitHub App and the tokens of connected people (AES-256-GCM). Empty: the server makes one in data/secret.
SWARMLOOP_SECRET=

GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
