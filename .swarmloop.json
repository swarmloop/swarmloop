{
  "version": 1,
  "image": "node:22-bookworm",
  "setup": "npm ci --prefix server && npm ci --prefix dashboard && bash scripts/ci-tools.sh lint",
  "checks": [
    {
      "run": "npm run typecheck --prefix server",
      "name": "server types",
      "paths": ["server/"]
    },
    {
      "run": "npm test --prefix server",
      "name": "server tests",
      "paths": ["server/", "defaults.env", "skills/", "scripts/jest-slowest-files.mjs", "scripts/slowest-files.mjs"]
    },
    {
      "run": "npm run typecheck --prefix dashboard",
      "name": "dashboard types",
      "paths": ["dashboard/", "server/src/contract", "package.json", "package-lock.json", "scripts/ci-tools.sh"]
    },
    {
      "run": "npm test --prefix dashboard",
      "name": "dashboard tests",
      "paths": [
        "dashboard/",
        "server/src/contract",
        "package.json",
        "package-lock.json",
        "scripts/ci-tools.sh",
        "scripts/vitest-slowest-files.mjs",
        "scripts/slowest-files.mjs"
      ]
    },
    {
      "run": "npx eslint .",
      "name": "eslint"
    },
    {
      "run": "node scripts/check-installed.mjs dashboard",
      "name": "dashboard tree"
    },
    {
      "run": "node_modules/.bin/knip --include files,exports,types",
      "name": "knip"
    },
    {
      "run": "node_modules/.bin/madge --circular --extensions ts,tsx --ts-config server/tsconfig.json server/src dashboard",
      "name": "cycles",
      "paths": ["server/src/", "dashboard/", "server/tsconfig.json", "package.json"]
    },
    {
      "run": "node --test scripts/ci-tools.test.mjs scripts/check-installed.test.mjs scripts/lint-run-state.test.mjs scripts/lint-git-process.test.mjs scripts/lint-sync-directory.test.mjs scripts/lint-test-imports.test.mjs scripts/lint-spec-rules.test.mjs scripts/complexity-baseline.test.mjs scripts/changed-files.test.mjs scripts/autofix.test.mjs scripts/slowest-files.test.mjs docker/egress/proxy.test.mjs",
      "name": "script tests",
      "paths": [
        "scripts/",
        "docker/egress/",
        "eslint.config.mjs",
        "eslint.spec-rules.mjs",
        "eslint.main-thread-rules.mjs",
        "eslint.strict.config.mjs",
        "eslint.complexity-baseline.mjs",
        "package.json",
        "package-lock.json",
        "dashboard/app",
        "server/src/pipeline/worktree-lock.spec.ts",
        "server/src/integrations/agent-runtime/claude/claude-hook.spec.ts",
        "server/src/sandbox/sandbox-stdin.spec.ts"
      ]
    },
    {
      "run": "node --test scripts/check-structure.test.mjs scripts/check-worktree.test.mjs scripts/check-paths.test.mjs && node scripts/check-structure.mjs",
      "name": "structure"
    },
    {
      "run": "node scripts/check-worktree.mjs",
      "name": "worktree lint"
    },
    {
      "run": "npm run build --prefix dashboard",
      "name": "dashboard build",
      "paths": ["dashboard/", "server/src/contract"]
    }
  ],
  "cache": ["/home/sandbox/.npm"]
}
