# Requirements and issue tracking.
# How requirements are collected.
REQUIREMENTS_VIA=agent
# Issue tracker for linked work.
ISSUE_TRACKER=jira
# Jira projects visible to the server.
JIRA_PROJECTS=
# GitLab host.
GITLAB_BASE_URL=https://gitlab.com
# GitHub host.
GITHUB_BASE_URL=https://github.com

# Headless setup: credentials are normally set in Connections.
# GitHub fallback token.
GITHUB_TOKEN=
# GitLab fallback token.
GITLAB_TOKEN=
# Cursor credential.
CURSOR_API_KEY=
# Anthropic credential.
ANTHROPIC_API_KEY=
# Claude subscription credential.
CLAUDE_CODE_OAUTH_TOKEN=
# Codex subscription credential.
CODEX_AUTH=
# Codex API credential.
CODEX_API_KEY=
# Jira host.
JIRA_BASE_URL=
# Jira account email.
JIRA_EMAIL=
# Jira credential.
JIRA_API_TOKEN=

# Pipeline limits and maintenance.
# Maximum agent calls per run.
MAX_AGENT_CALLS=100
# Maximum returns per step.
MAX_RETURNS=10
# Maximum returns per pipeline.
MAX_PIPELINE_RETURNS=6
# Maximum concurrent launches.
MAX_LAUNCHES=3
# Maximum check commands across the server.
CHECKS_PARALLEL=9
# Memory reserved for the server and dashboard.
RESERVE_MEMORY_GB=2
# Provider cooldown when no reset time is given, in minutes.
LIMIT_COOLDOWN_MIN=60
# Shutdown grace in seconds.
STOP_GRACE_S=10
# Reconciliation interval in milliseconds.
RECONCILE_MS=60000
# Minutes between checks for merged or closed requests.
MERGE_WATCH_MIN=5
# Recovery wait in milliseconds.
RECOVER_WAIT_MS=600000
# Days to retain completed runs; zero keeps everything.
RETAIN_DONE_DAYS=3
# Minimum free disk space in GB.
MIN_FREE_GB=10
# Prune dangling Docker images and old build cache daily.
DOCKER_PRUNE=true
# Maximum run spend in USD.
MAX_RUN_USD=100
# Optional run token cap; empty means unlimited.
MAX_RUN_TOKENS=
# Optional step spend cap; empty means unlimited.
STEP_USD_MAX=
# Optional step token cap; empty means unlimited.
STEP_TOKEN_MAX=
# Agent idle timeout in milliseconds.
IDLE_TIMEOUT_MS=900000
# Repeated failing commands before a hint and then a stop.
LOOP_REPEAT=4
# Sandbox internet access: proxy or open.
SANDBOX_EGRESS=proxy
# Sandbox Docker runtime; empty uses Docker's default.
SANDBOX_DOCKER_RUNTIME=
# Allowed project hosts; empty permits the built-in ceiling.
PROJECT_HOSTS_ALLOW=
# Pipeline tick in milliseconds.
TICK_MS=15000
# Requirements timeout in milliseconds.
REQUIREMENTS_TIMEOUT_MS=600000
# Research timeout in milliseconds.
RESEARCH_TIMEOUT_MS=900000
# Planning timeout in milliseconds.
PLAN_TIMEOUT_MS=1200000
# Implementation timeout in milliseconds.
IMPLEMENT_TIMEOUT_MS=1800000
# Review timeout in milliseconds.
CODE_REVIEW_TIMEOUT_MS=900000
# Merge request timeout in milliseconds.
MERGE_REQUEST_TIMEOUT_MS=600000
# CI timeout in milliseconds.
PIPELINE_TIMEOUT_MS=1800000
# CI start timeout in milliseconds.
PIPELINE_START_TIMEOUT_MS=180000

# Ordered runtime:model[:effort] agent lists.
# Main planning and research agents.
AGENTS_PLAN=claude:claude-opus-5-5:high
# Main implementation agents.
AGENTS_IMPLEMENT=claude:claude-sonnet-5-5:high
# Main review agents.
AGENTS_REVIEW=claude:claude-opus-5-5:high
# Subtask planning agents.
AGENTS_SUBTASK_PLAN=claude:claude-sonnet-5-5:high
# Subtask implementation agents.
AGENTS_SUBTASK_IMPLEMENT=claude:claude-sonnet-5-5:high
# Subtask review agents.
AGENTS_SUBTASK_REVIEW=claude:claude-sonnet-5-5:high
# Minimum parent effort after splitting; empty disables it.
EPIC_EFFORT=xhigh
# Permit automatic splitting or turn it off.
SPLIT=auto
# Maximum tasks in a split plan.
SPLIT_MAX_TASKS=48
# Concurrent subtasks per split run.
SUBTASKS_PARALLEL=3

# Paths and server addresses.
# Code root override; empty discovers the code root.
SWARMLOOP_ROOT=
# Checkouts folder, relative to the installation.
CHECKOUTS_ROOT=..
# Repository folder names, comma-separated; empty selects all.
SWARMLOOP_REPOS=
# Public dashboard address.
SWARMLOOP_PUBLIC_URL=http://127.0.0.1:3921
# API listen port.
SWARMLOOP_API_PORT=3920
# API listen host.
SWARMLOOP_API_HOST=127.0.0.1
# API address that bin/sloop and the ACP agent connect to.
SWARMLOOP_API_URL=http://127.0.0.1:3920
# Optional settings file override, selected only from the launch environment.
SWARMLOOP_ENV_FILE=
# Sandbox image registry; empty selects local images.
SWARMLOOP_REGISTRY=
# Sandbox image release tag.
SWARMLOOP_VERSION=latest
# Sandbox user ID.
SWARMLOOP_UID=1000
# Commit author name; empty uses existing git configuration.
GIT_AUTHOR_NAME=
# Commit author email; empty uses existing git configuration.
GIT_AUTHOR_EMAIL=

# Authentication.
# Optional GitHub OAuth client ID.
GITHUB_OAUTH_CLIENT_ID=
# Optional GitHub OAuth client secret.
GITHUB_OAUTH_CLIENT_SECRET=
# Optional GitLab OAuth client ID.
GITLAB_OAUTH_CLIENT_ID=
# Optional GitLab OAuth client secret.
GITLAB_OAUTH_CLIENT_SECRET=
# Allowed users and groups; empty uses repository access.
SWARMLOOP_ALLOW=
# Machine token; empty generates data/token.
SWARMLOOP_TOKEN=
# Encryption secret; empty generates data/secret.
SWARMLOOP_SECRET=
